            "example": [
              {
                "text": "Food",
                "isCorrect": true,
                "sortOrder": 1,
                "questionId": 1
              },
              {
                "text": "A new toy",
                "isCorrect": false,
                "sortOrder": 2,
                "questionId": 1
              }
            ],
            "type": "array",
            "items": { "$ref": "#/components/schemas/CreateQuestionOptionDto" }
          }
        }
      },
      "RequestOtpDto": {
        "type": "object",
        "properties": {
