      "GuidedLessonBlockPayloadDto": {
        "type": "object",
        "properties": {
          "introduction": {
            "type": "string",
            "example": "Read the guide before interacting with this block.",
            "description": "Required for drop_down, question_block, and film_and_image blocks."
          }
        },
        "required": ["introduction"]
      },
      "QuizLessonBlockPayloadDto": {
        "type": "object",
        "properties": {
          "quizId": {
            "type": "number",
            "example": 2,
            "description": "Quiz loaded by the game endpoint for a quiz block."
          }
        },
        "required": ["quizId"]
      },
      "LessonBlockType": {
        "type": "string",
        "description": "Determines how the client renders and interprets payload.",
        "enum": [
          "dialog",
          "image",
          "quiz",
          "story",
          "reward",
          "animation",
          "video",
          "drag_drop",
          "drop_down",
          "question_block",
          "film_and_image"
        ]
      },
      "CreateLessonBlockDto": {
        "type": "object",
        "properties": {
          "sortOrder": {
            "type": "number",
            "example": 1,
            "description": "Display order inside the lesson."
          },
          "type": {
            "example": "dialog",
            "$ref": "#/components/schemas/LessonBlockType"
          },
          "payload": {
            "additionalProperties": true,
            "description": "Flexible block data. drop_down, question_block, and film_and_image require a non-empty introduction. quiz blocks use quizId.",
            "oneOf": [
              { "$ref": "#/components/schemas/GuidedLessonBlockPayloadDto" },
              { "$ref": "#/components/schemas/QuizLessonBlockPayloadDto" },
              { "type": "object", "additionalProperties": true }
            ],
            "example": {
              "introduction": "Choose one of the available answers.",
              "label": "Select an answer",
              "options": [
                { "label": "Save money", "value": "save" },
                { "label": "Spend everything", "value": "spend" }
              ]
            }
          },
          "lessonId": {
            "type": "number",
            "example": 1,
            "description": "Existing lesson that owns this block."
          }
        },
        "required": ["sortOrder", "type", "payload", "lessonId"]
      },
      "UpdateLessonBlockDto": {
        "type": "object",
        "properties": {
          "sortOrder": {
            "type": "number",
            "example": 1,
            "description": "Display order inside the lesson."
          },
          "type": {
            "example": "dialog",
            "$ref": "#/components/schemas/LessonBlockType"
          },
          "payload": {
            "additionalProperties": true,
            "description": "Flexible block data. drop_down, question_block, and film_and_image require a non-empty introduction. quiz blocks use quizId.",
            "oneOf": [
              { "$ref": "#/components/schemas/GuidedLessonBlockPayloadDto" },
              { "$ref": "#/components/schemas/QuizLessonBlockPayloadDto" },
              { "type": "object", "additionalProperties": true }
            ],
            "example": {
              "introduction": "Choose one of the available answers.",
              "label": "Select an answer",
              "options": [
                { "label": "Save money", "value": "save" },
                { "label": "Spend everything", "value": "spend" }
              ]
            }
          },
          "lessonId": {
            "type": "number",
            "example": 1,
            "description": "Existing lesson that owns this block."
          }
        }
      },
      "CreateQuestionOptionDto": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "example": "Food",
            "description": "Answer option text."
          },
          "isCorrect": {
            "type": "boolean",
            "example": true,
            "description": "Whether this option is a correct answer."
          },
          "sortOrder": {
            "type": "number",
            "example": 1,
            "description": "Display order inside the question."
          },
          "questionId": {
            "type": "number",
            "example": 1,
            "description": "Required by the existing validation contract for nested question options."
          }
        },
        "required": ["text", "isCorrect", "sortOrder", "questionId"]
      },
      "CreateQuestionDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "Which item is a need?",
            "description": "Question text or title."
          },
          "description": {
            "type": "string",
            "example": "Think about things required for everyday life.",
            "description": "Optional supporting text."
          },
          "image": {
            "type": "string",
            "example": "questions/needs.png",
            "description": "Optional image path or URL."
          },
          "options": {
            "description": "Complete answer option list. Updating this field replaces existing options transactionally.",
            "example": [
              {
                "text": "Food",
                "isCorrect": true,
                "sortOrder": 1,
                "questionId": 1
              },
              {
                "text": "A new toy",
                "isCorrect": false,
                "sortOrder": 2,
                "questionId": 1
              }
            ],
            "type": "array",
            "items": { "$ref": "#/components/schemas/CreateQuestionOptionDto" }
          }
        },
        "required": ["title", "options"]
      },
      "UpdateQuestionDto": {
